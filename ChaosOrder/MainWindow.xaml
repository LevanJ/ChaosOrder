<Window x:Class="ChaosOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChaosOrder"
        xmlns:vm="clr-namespace:ChaosOrder.ViewModels"
        xmlns:conv="clr-namespace:ChaosOrder.Converters"
        mc:Ignorable="d"
        Title="Chaos and Order" Height="760" Width="1180" Background="Azure"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="commonwindowstyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:OffsetConverter x:Key="OffsetConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Settings panel ===================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>

                <GroupBox Header="Configuration File">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save..." Command="{Binding SaveConfigurationCommand}" Width="150" Height="35"/>
                        <Button Content="Load..." Command="{Binding LoadConfigurationCommand}" Width="150" Height="35" Margin="8,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Simulation">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Number of points:" VerticalAlignment="Center" Width="140"/>
                            <TextBox Text="{Binding NumberOfSimulations, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Simulate" Command="{Binding SimulateCommand}" Width="150" Height="35"/>
                            <Button Content="Clear" Command="{Binding ClearCommand}" Width="150" Height="35" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Normal" Foreground="Gray" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Figure">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Width="140"/>
                            <ComboBox ItemsSource="{Binding FigureTypeValues}" SelectedItem="{Binding SelectedFigureType}" Width="150"/>
                        </StackPanel>

                        <TextBlock Text="Corners (drag on canvas, or edit X/Y):" Margin="0,10,0,4" FontSize="13"/>
                        <DataGrid ItemsSource="{Binding Corners}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  MaxHeight="160" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}" Width="*"/>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="x" Padding="4,0"
                                                    Command="{Binding DataContext.RemoveCornerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add Corner" Command="{Binding AddCornerCommand}" Width="150" Height="35"/>
                            <Button Content="Make Regular" Command="{Binding MakeRegularCommand}" Width="150" Height="35" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Starting Point">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="X:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding StartPoint.X, StringFormat=F1}" Width="80" Margin="4,0,16,0"/>
                        <TextBlock Text="Y:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding StartPoint.Y, StringFormat=F1}" Width="80" Margin="4,0,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Rules (random direction selection)">
                    <StackPanel>
                        <Grid Margin="2,0,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="On" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="Direction" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="n=" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="3" Text="step" FontSize="11" Foreground="Gray"/>
                            <TextBlock Grid.Column="4" Text="weight" FontSize="11" Foreground="Gray"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#33000080" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>

                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.TargetTypeValues, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding TargetType}" Margin="0,0,4,0" FontSize="13"/>

                                            <TextBox Grid.Column="2" Text="{Binding N, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                                                            <TextBox Grid.Column="3" Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                                     ToolTip="Fraction of the remaining distance to move toward the target, e.g. 1/2, 2/3, or 0.5. A plain number like 2 is used as-is (2/1), which overshoots past the target."/>
                                            <TextBox Grid.Column="4" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>

                                            <Button Grid.Column="5" Content="x" Padding="4,0"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Add Rule" Command="{Binding AddRuleCommand}" Width="150" Height="35" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" FontWeight="Normal" Foreground="Gray" Margin="0,8,0,0"
                                   Text="Direction = Corners, middle of sides, or the 1/n-th point of each side (n=2 is the midpoint). Step = fraction of the remaining distance to jump toward the target, e.g. 1/2, 2/3, or 0.5. Each iteration, a rule is picked at random (weighted)."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Appearance">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Color:" VerticalAlignment="Center" Width="140"/>
                            <ComboBox ItemsSource="{Binding AvailableColors}" SelectedItem="{Binding SelectedColor}"
                                      DisplayMemberPath="Name" Width="150"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Thickness:" VerticalAlignment="Center" Width="140"/>
                            <Slider Minimum="1" Maximum="10" Value="{Binding Thickness}" Width="120"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Thickness, StringFormat=F0}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Drawing canvas ===================== -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="{x:Static vm:MainViewModel.CanvasSize}" Height="{x:Static vm:MainViewModel.CanvasSize}"
                RenderTransformOrigin="0.5,0.5" PreviewMouseWheel="DrawingCanvas_PreviewMouseWheel">
            <Border.RenderTransform>
                <ScaleTransform x:Name="DrawingScaleTransform" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid Width="{x:Static vm:MainViewModel.CanvasSize}" Height="{x:Static vm:MainViewModel.CanvasSize}" ClipToBounds="True">

                <Image Source="{Binding SimulationBitmap}" Stretch="None"
                       Width="{x:Static vm:MainViewModel.CanvasSize}" Height="{x:Static vm:MainViewModel.CanvasSize}"/>

                <Polygon Points="{Binding PolygonPoints}" Stroke="Gray" StrokeThickness="1.5"
                         Fill="Transparent" IsHitTestVisible="False"/>

                <ItemsControl ItemsSource="{Binding Corners}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="{x:Static vm:MainViewModel.CanvasSize}" Height="{x:Static vm:MainViewModel.CanvasSize}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource OffsetConverter}, ConverterParameter=7}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource OffsetConverter}, ConverterParameter=7}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Thumb Width="14" Height="14" Cursor="Hand" DragDelta="CornerThumb_DragDelta">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Ellipse Fill="RoyalBlue" Stroke="White" StrokeThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Canvas Width="{x:Static vm:MainViewModel.CanvasSize}" Height="{x:Static vm:MainViewModel.CanvasSize}">
                    <Thumb Width="16" Height="16" Cursor="Hand" DragDelta="StartThumb_DragDelta"
                           Canvas.Left="{Binding StartPoint.X, Converter={StaticResource OffsetConverter}, ConverterParameter=8}"
                           Canvas.Top="{Binding StartPoint.Y, Converter={StaticResource OffsetConverter}, ConverterParameter=8}">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Ellipse Fill="Red" Stroke="White" StrokeThickness="1.5"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>

            </Grid>
        </Border>

    </Grid>
</Window>
